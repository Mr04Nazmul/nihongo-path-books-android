# Server only. Neon pooled PostgreSQL URL, sslmode=verify-full where supported.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/nihongo?sslmode=require
MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@NEON_HOST/nihongo?sslmode=require
PORT=8080
CONTENT_ROOT=../../dist
# Separate staging DB and public callback for test ads. No local completion grants.
ADMOB_ALLOWED_UNITS=ca-app-pub-3940256099942544/5224354917
REWARDS_ENABLED=true
NODE_ENV=production
# Limit auth and reward attempts; process limits supplement DB single-use sessions.

# Supabase edition: set these ONLY in server environment. Use a dedicated project.
AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_FOR_ACCOUNT_DELETION
# DATABASE_URL and MIGRATION_DATABASE_URL must point to that Supabase Postgres.
